{
  "manifest_version": 3,
  "name": "Pinterest Wallpaper Bulk Downloader",
  "version": "1.0.0",
  "description": "Bulk download high-resolution original Pinterest pins directly to your wallpaper collection.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ]
}
